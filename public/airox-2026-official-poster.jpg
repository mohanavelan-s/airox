<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1400 980" width="100%" height="100%">
  <defs>
    <!-- Gradients -->
    <linearGradient id="airoxTitleGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ff5e00" />
      <stop offset="40%" stop-color="#ff0055" />
      <stop offset="100%" stop-color="#7a0099" />
    </linearGradient>

    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#ca8a04" />
    </linearGradient>

    <linearGradient id="cardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#f8fafc" />
    </linearGradient>

    <filter id="dropShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="3" dy="5" stdDeviation="4" flood-color="#000000" flood-opacity="0.25" />
    </filter>

    <filter id="titleShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="4" dy="6" stdDeviation="2" flood-color="#000000" flood-opacity="0.4" />
    </filter>
  </defs>

  <!-- Poster Base Background -->
  <rect width="1400" height="980" fill="#f1f5f9" rx="16" />
  
  <!-- Subtle Circuit Tech Lines Pattern -->
  <g opacity="0.12" stroke="#475569" stroke-width="1.5" fill="none">
    <path d="M 0 100 L 250 100 L 300 150 L 500 150" />
    <path d="M 1400 120 L 1150 120 L 1100 170 L 900 170" />
    <path d="M 0 500 L 180 500 L 220 540 L 400 540" />
    <path d="M 1400 600 L 1200 600 L 1150 550 L 950 550" />
    <circle cx="300" cy="150" r="4" fill="#475569" />
    <circle cx="1100" cy="170" r="4" fill="#475569" />
    <circle cx="220" cy="540" r="4" fill="#475569" />
    <circle cx="1150" cy="550" r="4" fill="#475569" />
  </g>

  <!-- ==================== LEFT ROBOTIC ARM GRAPHIC ==================== -->
  <g transform="translate(0, 0)">
    <!-- Main Arm Segments (Yellow hydraulic industrial arm) -->
    <path d="M -20 -20 L 110 60 L 60 220 L -20 180 Z" fill="#eab308" stroke="#1e293b" stroke-width="4" />
    <path d="M 60 220 L 140 380 L 80 480 L -20 350 Z" fill="#ca8a04" stroke="#1e293b" stroke-width="4" />
    <!-- Hydraulic Cylinders -->
    <circle cx="60" cy="220" r="28" fill="#334155" stroke="#0f172a" stroke-width="4" />
    <circle cx="60" cy="220" r="14" fill="#e2e8f0" />
    <circle cx="110" cy="60" r="20" fill="#334155" stroke="#0f172a" stroke-width="3" />
    <circle cx="80" cy="480" r="24" fill="#334155" stroke="#0f172a" stroke-width="4" />
    <!-- Cables -->
    <path d="M 10 30 Q 80 150 40 280" fill="none" stroke="#ef4444" stroke-width="6" />
    <path d="M 20 40 Q 90 160 50 290" fill="none" stroke="#3b82f6" stroke-width="5" />
    <!-- Arm Joint Caps -->
    <circle cx="60" cy="220" r="6" fill="#eab308" />
  </g>

  <!-- ==================== TOP RIGHT ROBOTIC HAND ==================== -->
  <g transform="translate(1000, 20)">
    <!-- Futuristic Mechanical Robot Hand -->
    <path d="M 320 -20 L 180 80 Q 140 120 100 150 Q 80 170 40 210" fill="none" stroke="#cbd5e1" stroke-width="28" stroke-linecap="round" />
    <path d="M 320 -20 L 180 80 Q 140 120 100 150 Q 80 170 40 210" fill="none" stroke="#0f172a" stroke-width="6" stroke-linecap="round" />
    <!-- Fingers -->
    <path d="M 100 150 L 40 180 L 10 200" fill="none" stroke="#e2e8f0" stroke-width="12" stroke-linecap="round" />
    <path d="M 120 130 L 60 150 L 25 170" fill="none" stroke="#e2e8f0" stroke-width="14" stroke-linecap="round" />
    <path d="M 140 110 L 90 125 L 50 140" fill="none" stroke="#e2e8f0" stroke-width="12" stroke-linecap="round" />
    <!-- Joints -->
    <circle cx="100" cy="150" r="8" fill="#3b82f6" />
    <circle cx="60" cy="150" r="6" fill="#3b82f6" />
    <circle cx="40" cy="180" r="6" fill="#3b82f6" />
  </g>

  <!-- ==================== HEADER LOGOS & INSTITUTION TITLE ==================== -->
  <!-- AIROX Flame Logo (Circle) -->
  <g transform="translate(210, 25)" filter="url(#dropShadow)">
    <circle cx="80" cy="60" r="55" fill="#090a0f" stroke="#1e293b" stroke-width="3" />
    <!-- Triangle Flame -->
    <polygon points="80,25 48,90 112,90" fill="none" stroke="url(#airoxTitleGrad)" stroke-width="6" stroke-linejoin="round" />
    <polygon points="80,40 60,82 100,82" fill="url(#airoxTitleGrad)" />
    <text x="80" y="105" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="13" fill="#ffffff" text-anchor="middle" letter-spacing="2">AIROX</text>
  </g>

  <!-- JJ College Logo (Shield Emblem) -->
  <g transform="translate(350, 20)" filter="url(#dropShadow)">
    <circle cx="45" cy="55" r="42" fill="#1e1b4b" stroke="#4338ca" stroke-width="3" />
    <!-- Inner emblem art -->
    <path d="M 45 25 L 70 45 L 62 80 L 45 90 L 28 80 L 20 45 Z" fill="#ffffff" />
    <path d="M 45 30 L 65 48 L 58 76 L 45 84 L 32 76 L 25 48 Z" fill="#dc2626" />
    <text x="45" y="60" font-family="sans-serif" font-weight="900" font-size="18" fill="#ffffff" text-anchor="middle">JJ</text>
    <text x="45" y="112" font-family="sans-serif" font-weight="700" font-size="10" fill="#1e1b4b" text-anchor="middle">ESTD. 1994</text>
  </g>

  <!-- Institution Center Text -->
  <g transform="translate(460, 25)">
    <text x="240" y="32" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="34" fill="#1e1b4b" text-anchor="middle" letter-spacing="1">JJ COLLEGE</text>
    <text x="240" y="60" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="22" fill="#1e1b4b" text-anchor="middle" letter-spacing="0.5">ENGINEERING AND TECHNOLOGY</text>
    
    <!-- AUTONOMOUS Pill -->
    <text x="240" y="80" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="14" fill="#f97316" text-anchor="middle" letter-spacing="2">AUTONOMOUS</text>
    
    <!-- SOWDAMBIKAA Banner -->
    <rect x="50" y="90" width="380" height="26" rx="6" fill="#dc2626" />
    <text x="240" y="108" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="13" fill="#ffffff" text-anchor="middle" letter-spacing="2">SOWDAMBIKAA GROUP OF INSTITUTIONS</text>
  </g>

  <!-- ISTE Logo (Top Right) -->
  <g transform="translate(1210, 20)" filter="url(#dropShadow)">
    <circle cx="50" cy="55" r="45" fill="#1e1b4b" stroke="#38bdf8" stroke-width="3" />
    <circle cx="50" cy="55" r="38" fill="#ffffff" />
    <circle cx="50" cy="55" r="28" fill="#1e1b4b" />
    <text x="50" y="52" font-family="sans-serif" font-weight="900" font-size="12" fill="#ffffff" text-anchor="middle">ISTE</text>
    <text x="50" y="66" font-family="sans-serif" font-weight="700" font-size="8" fill="#38bdf8" text-anchor="middle">CHAPTER</text>
    <text x="50" y="112" font-family="sans-serif" font-weight="800" font-size="11" fill="#1e1b4b" text-anchor="middle">ISTE</text>
  </g>

  <!-- ==================== MAIN TITLE AREA ==================== -->
  <g transform="translate(0, 150)">
    <!-- Giant AIROX 3D Text -->
    <g filter="url(#titleShadow)">
      <text x="700" y="110" font-family="'Impact', 'Arial Black', system-ui, sans-serif" font-weight="900" font-size="115" fill="url(#airoxTitleGrad)" stroke="#0f172a" stroke-width="5" text-anchor="middle" letter-spacing="6">AIROX</text>
    </g>

    <!-- AI REPUBLIC OF EXCELLENCE -->
    <text x="700" y="150" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="28" fill="#1e1b4b" text-anchor="middle" letter-spacing="4">AI REPUBLIC OF EXCELLENCE</text>

    <!-- TECHNICAL SYMPOSIUM Ribbon -->
    <g transform="translate(420, 168)" filter="url(#dropShadow)">
      <rect x="0" y="0" width="560" height="42" rx="10" fill="#1e1b4b" stroke="#f97316" stroke-width="2" />
      <!-- Left & Right Arrow Accent Tabs -->
      <polygon points="-12,21 0,5 0,37" fill="#f97316" />
      <polygon points="572,21 560,5 560,37" fill="#f97316" />
      <text x="280" y="28" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="22" fill="#ffffff" text-anchor="middle" letter-spacing="5">TECHNICAL SYMPOSIUM</text>
    </g>

    <!-- Date & Venue Bar -->
    <g transform="translate(350, 226)">
      <rect x="0" y="0" width="700" height="50" rx="25" fill="#ffffff" stroke="#a855f7" stroke-width="2" filter="url(#dropShadow)" />
      <text x="200" y="32" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="20" fill="#0f172a">📅 22<tspan font-size="13" baseline-shift="super">ND</tspan> AUGUST 2026</text>
      <line x1="380" y1="12" x2="380" y2="38" stroke="#cbd5e1" stroke-width="2" />
      <text x="520" y="32" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="20" fill="#0f172a">📍 JJCET AUDITORIUM</text>
    </g>

    <!-- Department & ISTE Tagline -->
    <text x="700" y="300" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="15" fill="#334155" text-anchor="middle">
      Organized by the Department of Artificial Intelligence and Data Science
    </text>
    <text x="700" y="320" font-family="'Inter', system-ui, sans-serif" font-weight="600" font-size="13" fill="#64748b" text-anchor="middle">
      in association with Indian Society for Technical Education (ISTE)
    </text>
  </g>

  <!-- ==================== MAIN CONTENT GRID (CARDS) ==================== -->
  
  <!-- 1. LEFT CARD: SCAN FOR REGISTRATION (QR Code) -->
  <g transform="translate(30, 520)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="200" height="310" rx="20" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />
    <!-- Header -->
    <path d="M 0 20 Q 0 0 20 0 L 180 0 Q 200 0 200 20 L 200 50 L 0 50 Z" fill="#1e1b4b" />
    <text x="100" y="25" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="12" fill="#ffffff" text-anchor="middle">SCAN FOR</text>
    <text x="100" y="40" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="13" fill="#38bdf8" text-anchor="middle">REGISTRATION</text>

    <!-- QR Code graphic box -->
    <g transform="translate(20, 65)">
      <rect x="0" y="0" width="160" height="160" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" rx="8" />
      <!-- Realistic Vector QR Pattern -->
      <path d="M 10 10 H 50 V 50 H 10 Z M 20 20 H 40 V 40 H 20 Z" fill="#0f172a" />
      <path d="M 110 10 H 150 V 50 H 110 Z M 120 20 H 140 V 40 H 120 Z" fill="#0f172a" />
      <path d="M 10 110 H 50 V 150 H 10 Z M 20 120 H 40 V 140 H 20 Z" fill="#0f172a" />
      <rect x="65" y="10" width="35" height="15" fill="#0f172a" />
      <rect x="65" y="35" width="20" height="30" fill="#0f172a" />
      <rect x="10" y="65" width="40" height="15" fill="#0f172a" />
      <rect x="60" y="80" width="40" height="40" fill="#0f172a" />
      <rect x="110" y="65" width="20" height="35" fill="#0f172a" />
      <rect x="110" y="110" width="40" height="15" fill="#0f172a" />
      <rect x="135" y="130" width="15" height="20" fill="#0f172a" />
      <rect x="70" y="130" width="30" height="20" fill="#0f172a" />
    </g>

    <!-- Social Handles -->
    <g transform="translate(20, 240)">
      <text x="0" y="18" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="13" fill="#e11d48">📷 ._airox._</text>
      <text x="0" y="42" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="14" fill="#0369a1">🌐 airox.co.in</text>
    </g>
  </g>

  <!-- 2. TECHNICAL EVENTS CARD -->
  <g transform="translate(245, 520)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="320" height="310" rx="20" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />
    <!-- Header Ribbon -->
    <path d="M 20 0 L 300 0 Q 320 0 320 20 L 320 48 L 0 48 L 0 20 Q 0 0 20 0 Z" fill="#1e1b4b" />
    <text x="160" y="30" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="16" fill="#ffffff" text-anchor="middle" letter-spacing="2">TECHNICAL EVENTS</text>

    <!-- List Items -->
    <g transform="translate(20, 65)">
      <!-- Item 1 -->
      <g transform="translate(0, 0)">
        <text x="0" y="24" font-size="20">📋</text>
        <text x="32" y="24" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="17" fill="#0f172a">Paper Presentation</text>
      </g>
      <!-- Item 2 -->
      <g transform="translate(0, 52)">
        <text x="0" y="24" font-size="20">🎧</text>
        <text x="32" y="24" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="17" fill="#0f172a">Final Hiring</text>
      </g>
      <!-- Item 3 -->
      <g transform="translate(0, 104)">
        <text x="0" y="24" font-size="20">⚛️</text>
        <text x="32" y="24" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="16" fill="#0f172a">Zero Hour <tspan font-size="12" font-weight="600" fill="#64748b">- The AI Build Sprint</tspan></text>
      </g>
      <!-- Item 4 -->
      <g transform="translate(0, 156)">
        <text x="0" y="24" font-size="20">🎯</text>
        <text x="32" y="24" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="17" fill="#0f172a">The Prompt League</text>
      </g>
    </g>
  </g>

  <!-- 3. NON - TECHNICAL EVENTS CARD -->
  <g transform="translate(580, 520)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="370" height="310" rx="20" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />
    <!-- Header Ribbon -->
    <path d="M 20 0 L 350 0 Q 370 0 370 20 L 370 48 L 0 48 L 0 20 Q 0 0 20 0 Z" fill="#1e1b4b" />
    <text x="185" y="30" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="16" fill="#ffffff" text-anchor="middle" letter-spacing="2">NON - TECHNICAL EVENTS</text>

    <!-- List Items -->
    <g transform="translate(20, 60)">
      <g transform="translate(0, 0)">
        <text x="0" y="22" font-size="18">📢</text>
        <text x="30" y="22" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="16" fill="#0f172a">Ad Battle</text>
      </g>
      <g transform="translate(0, 42)">
        <text x="0" y="22" font-size="18">🧠</text>
        <text x="30" y="22" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="16" fill="#0f172a">Goated or Ghosted</text>
      </g>
      <g transform="translate(0, 84)">
        <text x="0" y="22" font-size="18">👥</text>
        <text x="30" y="22" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="16" fill="#0f172a">Clash and Conquer</text>
      </g>
      <g transform="translate(0, 126)">
        <text x="0" y="22" font-size="18">🏏</text>
        <text x="30" y="22" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="16" fill="#0f172a">Box Cricket</text>
      </g>
      <g transform="translate(0, 168)">
        <text x="0" y="22" font-size="18">🎮</text>
        <text x="30" y="22" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="15" fill="#0f172a">E-Sports <tspan font-size="12" font-weight="600" fill="#64748b">- Free Fire &amp; Stumble Guys</tspan></text>
      </g>
    </g>
  </g>

  <!-- 4. RIGHT TOP CARD: REGISTRATION DETAILS -->
  <g transform="translate(965, 480)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="405" height="210" rx="20" fill="#ffffff" stroke="#8b5cf6" stroke-width="2" />
    
    <!-- Header -->
    <rect x="40" y="-14" width="325" height="30" rx="15" fill="#1e1b4b" />
    <text x="202" y="6" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="14" fill="#ffffff" text-anchor="middle" letter-spacing="2">★ REGISTRATION ★</text>

    <!-- Prices -->
    <text x="30" y="48" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="18" fill="#0f172a">• Online – <tspan fill="#059669">₹200</tspan></text>
    <text x="210" y="48" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="18" fill="#0f172a">• On-Spot – <tspan fill="#d97706">₹250</tspan></text>

    <!-- Orange On-Spot Ribbon -->
    <g transform="translate(20, 64)">
      <rect x="0" y="0" width="365" height="28" rx="6" fill="#ea580c" />
      <text x="182" y="19" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="13" fill="#ffffff" text-anchor="middle" letter-spacing="2">ON-SPOT REGISTRATION AVAILABLE</text>
    </g>

    <text x="30" y="118" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="14" fill="#6b21a8">• Registration closes: <tspan font-weight="900">21st August, Midnight</tspan></text>
    <text x="30" y="142" font-family="'Inter', system-ui, sans-serif" font-weight="600" font-size="14" fill="#334155">• Certificates for all participants</text>
    <text x="30" y="166" font-family="'Inter', system-ui, sans-serif" font-weight="600" font-size="14" fill="#334155">• 3 winners in each event</text>
  </g>

  <!-- 5. RIGHT BOTTOM CARD: OVERALL TITLE MR & MS AIROX -->
  <g transform="translate(965, 700)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="405" height="130" rx="20" fill="#ffffff" stroke="#eab308" stroke-width="2" />
    
    <!-- Header -->
    <rect x="80" y="-12" width="245" height="26" rx="13" fill="#1e1b4b" />
    <text x="202" y="5" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="12" fill="#eab308" text-anchor="middle" letter-spacing="2">OVERALL TITLE</text>

    <!-- Trophy Graphic -->
    <g transform="translate(20, 20)">
      <text x="0" y="65" font-size="55">🏆</text>
    </g>

    <!-- MR. & MS. AIROX Text -->
    <g transform="translate(100, 30)">
      <text x="140" y="32" font-family="'Inter', system-ui, sans-serif" font-weight="900" font-size="30" fill="#1e1b4b" text-anchor="middle" letter-spacing="2">MR. &amp; MS.</text>
      <text x="140" y="70" font-family="'Impact', system-ui, sans-serif" font-weight="900" font-size="44" fill="url(#airoxTitleGrad)" text-anchor="middle" letter-spacing="3">AIROX</text>
    </g>
  </g>

  <!-- ==================== FOOTER COORDINATORS BAR ==================== -->
  <g transform="translate(30, 850)" filter="url(#dropShadow)">
    <rect x="0" y="0" width="1340" height="95" rx="16" fill="#ffffff" stroke="#cbd5e1" stroke-width="2" />

    <!-- Column 1: Convenor -->
    <g transform="translate(30, 20)">
      <rect x="70" y="0" width="140" height="24" rx="12" fill="#1e1b4b" />
      <text x="140" y="16" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff" text-anchor="middle">CONVENOR</text>
      
      <text x="20" y="48" font-size="22">👤</text>
      <text x="50" y="48" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="14" fill="#0f172a">Mr. K. Saravana Kumar, <tspan font-size="12" fill="#64748b">HOD</tspan></text>
    </g>

    <line x1="320" y1="15" x2="320" y2="80" stroke="#e2e8f0" stroke-width="2" />

    <!-- Column 2: Student Coordinators -->
    <g transform="translate(350, 20)">
      <rect x="110" y="0" width="190" height="24" rx="12" fill="#1e1b4b" />
      <text x="205" y="16" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff" text-anchor="middle">STUDENT COORDINATORS</text>

      <text x="10" y="45" font-size="22">👥</text>
      <text x="42" y="42" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="13" fill="#0f172a">Lekshman S – <tspan font-weight="800" fill="#0284c7">+91 91503 13122</tspan></text>
      <text x="42" y="62" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="13" fill="#0f172a">Bhula Nancy D – <tspan font-weight="800" fill="#0284c7">+91 91762 00584</tspan></text>
    </g>

    <line x1="770" y1="15" x2="770" y2="80" stroke="#e2e8f0" stroke-width="2" />

    <!-- Column 3: Faculty Coordinators -->
    <g transform="translate(800, 20)">
      <rect x="120" y="0" width="190" height="24" rx="12" fill="#1e1b4b" />
      <text x="215" y="16" font-family="'Inter', system-ui, sans-serif" font-weight="800" font-size="11" fill="#ffffff" text-anchor="middle">FACULTY COORDINATORS</text>

      <text x="10" y="45" font-size="22">👨‍🏫</text>
      <text x="42" y="38" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="12" fill="#0f172a">• Mrs. G. Deepalakshmi</text>
      <text x="42" y="54" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="12" fill="#0f172a">• Mrs. P. Sumathi</text>
      <text x="42" y="70" font-family="'Inter', system-ui, sans-serif" font-weight="700" font-size="12" fill="#0f172a">• Mrs. M. Shanmugapriya</text>
    </g>
  </g>

</svg>
