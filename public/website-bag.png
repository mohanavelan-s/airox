<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1920 1080' width='1920' height='1080'>
<defs>
  <!-- Main Radial Glows -->
  <radialGradient id='cyanCore' cx='0%' cy='100%' r='70%'>
    <stop offset='0%' stop-color='#00f2ff' stop-opacity='0.9'/>
    <stop offset='25%' stop-color='#0088ff' stop-opacity='0.5'/>
    <stop offset='50%' stop-color='#003366' stop-opacity='0.25'/>
    <stop offset='85%' stop-color='#030712' stop-opacity='0'/>
  </radialGradient>

  <radialGradient id='magentaCore' cx='100%' cy='0%' r='70%'>
    <stop offset='0%' stop-color='#f0abfc' stop-opacity='0.85'/>
    <stop offset='25%' stop-color='#c026d3' stop-opacity='0.5'/>
    <stop offset='55%' stop-color='#581c87' stop-opacity='0.25'/>
    <stop offset='85%' stop-color='#030712' stop-opacity='0'/>
  </radialGradient>

  <radialGradient id='cyanSubGlow' cx='10%' cy='90%' r='40%'>
    <stop offset='0%' stop-color='#38bdf8' stop-opacity='0.6'/>
    <stop offset='100%' stop-color='#030712' stop-opacity='0'/>
  </radialGradient>

  <radialGradient id='magentaSubGlow' cx='90%' cy='10%' r='40%'>
    <stop offset='0%' stop-color='#e879f9' stop-opacity='0.6'/>
    <stop offset='100%' stop-color='#030712' stop-opacity='0'/>
  </radialGradient>

  <!-- Grid Pattern -->
  <pattern id='techGrid' width='60' height='60' patternUnits='userSpaceOnUse'>
    <path d='M 60 0 L 0 0 0 60' fill='none' stroke='#1e293b' stroke-width='0.7' stroke-opacity='0.25'/>
    <circle cx='0' cy='0' r='1' fill='#38bdf8' fill-opacity='0.25'/>
  </pattern>

  <filter id='glow' x='-20%' y='-20%' width='140%' height='140%'>
    <feGaussianBlur stdDeviation='4' result='blur' />
    <feComposite in='SourceGraphic' in2='blur' operator='over' />
  </filter>
</defs>

<!-- Deep Black Base Background -->
<rect width='1920' height='1080' fill='#030712'/>

<!-- Tech Grid -->
<rect width='1920' height='1080' fill='url(#techGrid)'/>

<!-- Ambient Glows -->
<rect width='1920' height='1080' fill='url(#cyanCore)' style='mix-blend-mode: screen;'/>
<rect width='1920' height='1080' fill='url(#magentaCore)' style='mix-blend-mode: screen;'/>
<rect width='1920' height='1080' fill='url(#cyanSubGlow)' style='mix-blend-mode: screen;'/>
<rect width='1920' height='1080' fill='url(#magentaSubGlow)' style='mix-blend-mode: screen;'/>

