{
  "version": 2,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/register($|/|\\?.*)",
      "dest": "/index.html"
    },
    {
      "src": "^/($|\\?.*)",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}

